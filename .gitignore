.claude/
# unpublished tracks stay local-only
tracks/2026-au-nats-v3-polished.json
tracks/aus-nats.json
tracks/manifest.local.json
tracks/*.xml
tracks/_test-*.json
# local model-extraction venv (UnityPy etc.) — never commit
venv/
# Extracted prefab models: only the shipped subset listed in models/models.json
# is committed (its .glb files were already tracked). The full ~3300-model
# extraction stays local as a cache — new .glb files are ignored here, and the
# full index lives in the gitignored models.local.json overlay the viewer
# prefers when present. To ship a new track's model: `git add -f models/<x>.glb`
# and add its entry to models/models.json.
models/*.glb
models/models.local.json
# MRSIM object meshes/textures decoded from MRSIM.dkb (export_mrsim_models.py).
# These are the game developer's copyrighted assets — NOT redistributed. The
# whole dir is a local-only cache: on the deployed site MRSIM objects render
# procedurally from their collision primitives (see app.js buildTrackMrsim).
# The full model index lives in the gitignored models.local.json overlay the
# viewer prefers when present; the committed models.json is an empty subset
# (no MRSIM tracks are published). To ship an MRSIM track's gates one day,
# `git add -f models/mrsim/<x>.glb` and add its entry to models/mrsim/models.json.
models/mrsim/
!models/mrsim/models.json
# node deps for the converter CLI + tests (`npm install && npm test`); the
# viewer itself still runs from a CDN import map with no build step
node_modules/
# ad-hoc local runner scripts stay out of the repo (root only)
/_*.mjs
# tool droppings
__pycache__/
.wrangler/
